{
  "// README": "OpenCode configuration for Vision-managed MCP servers.",
  "// Locations": [
    "$HOME/.opencode.json (global)",
    "$XDG_CONFIG_HOME/opencode/.opencode.json (global alt)",
    "./.opencode.json (project-local)"
  ],
  "// Note": "Vision exposes MCP servers via HTTP/SSE, so use type 'sse' with url.",

  "mcpServers": {
    "time": {
      "type": "sse",
      "url": "http://localhost:6276/mcp"
    },
    "context7": {
      "type": "sse",
      "url": "http://localhost:6277/mcp"
    },
    "filesystem": {
      "type": "sse",
      "url": "http://localhost:6278/mcp"
    }
  }
}
