[Unit]
Description=Vision MCP Daemon (User)
Documentation=https://github.com/Sharper-Flow/Vision-MCP-Manager
# No After= ordering against default.target: this unit is enabled into
# default.target.wants, and systemd's default target dependency already orders
# default.target after the services it wants. Adding After=default.target here
# closes the cycle vision -> default.target -> penpot-mcp-bridge -> vision, and
# boot then drops the penpot bridge start job to break it.

[Service]
Type=simple
ExecStart=%h/.local/bin/vision daemon start
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
Environment="PATH=__VISION_PATH__"

# Environment file for API keys and secrets (optional)
EnvironmentFile=-%h/.config/vision/environment

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vision

[Install]
WantedBy=default.target
